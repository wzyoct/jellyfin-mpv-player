{
  "name": "ember-player",
  "version": "0.4.0",
  "description": "A focused Emby desktop client powered by MPV.",
  "productName": "Ember Player",
  "main": "dist-electron/electron/main.js",
  "author": "Ember Player",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "test:contract": "npm run build:electron && node scripts/emby-contract-smoke.cjs",
    "test:subtitle": "vitest run src/subtitlePreference.test.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "release:check": "node scripts/check-version.cjs",
    "release:notes": "node scripts/sync-release-notes.cjs",
    "dist": "npm run build && electron-builder",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-vue-next": "^0.468.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.emberplayer.desktop",
    "productName": "Ember Player",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
